{
  "name": "@mtngtools/unstorage",
  "type": "module",
  "version": "0.2.0",
  "description": "Custom storage drivers for unstorage with AWS S3 support",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./drivers/aws-s3": {
      "types": "./dist/drivers/aws-s3/index.d.ts",
      "import": "./dist/drivers/aws-s3/index.js",
      "require": "./dist/drivers/aws-s3/index.cjs"
    },
    "./drivers/aws-ssm": {
      "types": "./dist/drivers/aws-ssm/index.d.ts",
      "import": "./dist/drivers/aws-ssm/index.js",
      "require": "./dist/drivers/aws-ssm/index.cjs"
    },
    "./drivers/aws-dynamodb": {
      "types": "./dist/drivers/aws-dynamodb/index.d.ts",
      "import": "./dist/drivers/aws-dynamodb/index.js",
      "require": "./dist/drivers/aws-dynamodb/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:min": "vitest run --reporter=dot",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:ui": "vitest --ui --config vitest.e2e.config.ts",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "prepublishOnly": "pnpm run typecheck && pnpm run test:typecheck && pnpm run lint && pnpm run build && pnpm run test"
  },
  "keywords": [
    "storage",
    "unstorage",
    "aws",
    "s3",
    "ssm",
    "drivers",
    "typescript"
  ],
  "author": "Jason Bulson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtngtools/mtng-unstorage.git"
  },
  "bugs": {
    "url": "https://github.com/mtngtools/mtng-unstorage/issues"
  },
  "homepage": "https://github.com/mtngtools/mtng-unstorage#readme",
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/client-ssm": "^3.927.0",
    "unstorage": "^1.0.0",
    "@aws-sdk/client-dynamodb": "^3.927.0",
    "@aws-sdk/lib-dynamodb": "^3.927.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/client-ssm": "^3.927.0",
    "@types/node": "^20.19.24",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.9",
    "oxlint": "^1.26.0",
    "vite-plugin-oxlint": "^1.4.0",
    "typescript": "^5.9.3",
    "unstorage": "^1.17.2",
    "vite": "npm:rolldown-vite@7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.9",
    "@aws-sdk/client-dynamodb": "^3.927.0",
    "@aws-sdk/lib-dynamodb": "^3.927.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "destr": "^2.0.5"
  }
}