{
  "name": "@mtngtools/unstorage",
  "type": "module",
  "version": "0.2.0",
  "description": "Custom storage drivers for unstorage with AWS S3 support",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./aws-s3": {
      "types": "./dist/drivers/aws-s3/aws-s3.d.ts",
      "import": "./dist/drivers/aws-s3/aws-s3.js",
      "require": "./dist/drivers/aws-s3/aws-s3.cjs"
    },
    "./aws-s3-flex": {
      "types": "./dist/drivers/aws-s3/aws-s3-flex.d.ts",
      "import": "./dist/drivers/aws-s3/aws-s3-flex.js",
      "require": "./dist/drivers/aws-s3/aws-s3-flex.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:min": "vitest run --reporter=dot",
    "test:e2e": "VITEST_POOL_THREADS=false NODE_ENV=test vitest run tests-e2e --config vitest.e2e.config.ts",
    "test:e2e:ui": "vitest tests-e2e --ui --config vitest.e2e.config.ts",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
  "lint": "oxlint src",
  "lint:fix": "oxlint src --fix",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test"
  },
  "keywords": [
    "storage",
    "unstorage",
    "aws",
    "s3",
    "drivers",
    "typescript"
  ],
  "author": "Jason Bulson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtngtools/mtng-unstorage.git"
  },
  "bugs": {
    "url": "https://github.com/mtngtools/mtng-unstorage/issues"
  },
  "homepage": "https://github.com/mtngtools/mtng-unstorage#readme",
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "unstorage": "^1.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@types/node": "^20.19.24",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "4.0.9",
    "oxlint": "^1.26.0",
    "vite-plugin-oxlint": "^1.4.0",
    "typescript": "^5.9.3",
    "unstorage": "^1.17.2",
    "vite": "npm:rolldown-vite@7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "destr": "^2.0.5"
  }
}