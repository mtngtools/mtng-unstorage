# E2E Test Configuration
# Copy this to .env.test.e2e.local and configure for your local testing

# Enable/disable E2E tests
AWS_S3_E2E_ENABLED=false
AWS_SSM_E2E_ENABLED=false

# AWS S3 Configuration for E2E tests
# Replace with your actual test bucket name
AWS_S3_TEST_BUCKET=your-test-bucket-name-here

# Prefix for test data isolation (recommended to include your username)
AWS_S3_TEST_PREFIX=test-mtng-unstorage-e2e-
AWS_SSM_TEST_PREFIX=/test/mtng-unstorage/e2e
AWS_DDB_TEST_PREFIX=test-mtng-unstorage-e2e-

# AWS DynamoDB Configuration for E2E tests
# Table 1: Primary Key + Sort Key, with LSI and GSI (PK+SK)
# Used for strategies: table_pk_sk, lsi, gsi_pk_sk
AWS_DDB_TABLE_PK_SK=test-table-pk-sk-lsi-gsi

# Table 2: Primary Key only (no SK on base table), with GSI (PK only)
# Used for strategies: table_pk, gsi_pk
AWS_DDB_TABLE_PK=test-table-pk-gsi

# Index Names
AWS_DDB_LSI_INDEX_NAME=lsi-index1
AWS_DDB_GSI_Index_NAME=gsi-index1

# Key Names (optional overrides)
# AWS_DDB_PK_NAME=pk
# AWS_DDB_SK_NAME=sk
# AWS_DDB_LSK_NAME=lsk
# AWS_DDB_GPK_NAME=gpk
# AWS_DDB_GSK_NAME=gsk



# AWS Region (optional - will use your default AWS configuration if not set)
# AWS_REGION=us-east-1

# Note: AWS credentials should be configured via:
# - AWS credentials file (~/.aws/credentials)
# - AWS config file (~/.aws/config)  
# - Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# - IAM roles (if running on EC2)
# Never commit AWS credentials to version control!